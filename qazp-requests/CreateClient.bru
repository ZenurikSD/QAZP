meta {
  name: CreateClient
  type: http
  seq: 3
}

post {
  url: http://localhost:5196/api/Client
  body: json
  auth: inherit
}

body:json {
  {
    "fullName": "{{name}}",
    "documentId": "{{documentId}}",
    "phoneNumber": "{{phoneNumber}}",
    "email": "{{email}}",
    "zipCode": "{{zipCode}}",
    "addressName": "{{addressName}}",
    "addressNumber": "{{addressNumber}}",
    "addressComplement": "{{addressComplement}}",
    "district": "{{district}}",
    "state": "{{state}}",
    "city": "{{city}}"
  }
}

